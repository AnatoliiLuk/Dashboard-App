{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint*)",
      "Bash(npm run typecheck*)",
      "Bash(npm run spellcheck*)",
      "Bash(npm test*)",
      "Bash(npm run test*)",
      "Bash(npx prisma generate)",
      "Bash(npx prisma validate)",
      "Bash(npx prettier --check *)",
      "Bash(npx cspell *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)"
    ],
    "deny": [
      "Read(./.env)",
      "Edit(./.env)",
      "Read(./apps/*/.env.local)",
      "Edit(./apps/*/.env.local)",
      "Edit(./prisma/migrations/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-file.sh",
            "timeout": 60,
            "statusMessage": "Formatting"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/typecheck-changed.sh",
            "timeout": 180,
            "statusMessage": "Typechecking changed workspaces"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/related-tests.sh",
            "timeout": 300,
            "statusMessage": "Running related tests"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/openapi-drift.sh",
            "timeout": 30,
            "statusMessage": "Checking openapi.yaml"
          }
        ]
      }
    ]
  }
}
