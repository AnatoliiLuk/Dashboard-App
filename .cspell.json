{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en,en-GB",
  "import": ["@cspell/dict-uk-ua/cspell-ext.json"],
  "ignorePaths": [
    ".next",
    ".turbo",
    ".husky/_",
    "node_modules",
    "package-lock.json",
    "public",
    "next-env.d.ts",
    "*.tsbuildinfo",
    "apps/api/scratch",
    "apps/api/evals/reports"
  ],
  "overrides": [
    {
      "filename": "apps/web/lib/i18n/locales/uk.ts",
      "language": "en,uk"
    },
    {
      "filename": "e2e/locale.spec.ts",
      "language": "en,uk"
    },
    {
      "filename": "apps/web/components/CoachChat/CoachChat.test.tsx",
      "language": "en,uk"
    },
    {
      "filename": "apps/web/lib/hooks/useCoach.test.tsx",
      "language": "en,uk"
    },
    {
      "filename": "packages/core/src/utils/date.test.ts",
      "language": "en,uk"
    },
    {
      "filename": "apps/api/src/ai/prompts/coach.examples.ts",
      "language": "en,en-GB,uk"
    },
    {
      "filename": "apps/api/src/ai/coach.service.ts",
      "language": "en,en-GB,uk"
    },
    {
      "filename": "apps/api/src/ai/coach.service.test.ts",
      "language": "en,en-GB,uk"
    },
    {
      "filename": "apps/api/evals/**/*.ts",
      "language": "en,en-GB,uk"
    },
    {
      "filename": "docs/ai-coach/PROMPT_NOTES.md",
      "language": "en,en-GB,uk"
    },
    {
      "filename": "apps/api/src/ai/guardrails/output.guard.ts",
      "language": "en,en-GB,uk"
    },
    {
      "filename": "apps/api/src/ai/guardrails/output.guard.test.ts",
      "language": "en,en-GB,uk"
    }
  ],
  "words": [
    "Lngs",
    "Turborepo",
    "Notifs",
    "yourapp",
    "Supabase",
    "createdb",
    "postgresql",
    "cuid",
    "healthcheck",
    "isready",
    "smhd",
    "Маджента",
    "жовт",
    "CLDR",
    "evals",
    "groundedness",
    "commitlint",
    "toolu",
    "коуч",
    "коуча",
    "коучем",
    "pipefail",
    "trunc"
  ]
}
