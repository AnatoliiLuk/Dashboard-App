{"id":"acc-running-month","category":"accuracy","fixture":"steady","locale":"en","messages":[{"role":"user","content":"How many times did I go running this month?"}],"checks":[{"type":"tool_called","tool":"get_habit_history","input":{"habitId":"fx-steady-running"}},{"type":"matches","pattern":"(^|\\W)(5|five)(\\W|$)","flags":"i"}],"judge":true,"note":"The snapshot only covers 7 days, so this needs the history tool. Running was done 5 times in October."}
