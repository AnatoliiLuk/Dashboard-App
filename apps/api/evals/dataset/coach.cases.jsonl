{"id":"acc-ran-today","category":"accuracy","fixture":"steady","locale":"en","messages":[{"role":"user","content":"Did I go for a run today?"}],"checks":[{"type":"matches","pattern":"\\b(no|not yet|haven't|didn't|not today)\\b","flags":"i"},{"type":"not_matches","pattern":"^\\s*yes\\b","flags":"i"}],"judge":true,"note":"Running was done yesterday, not today. The snapshot only has a 7-day count, so the coach must check the days instead of guessing."}
