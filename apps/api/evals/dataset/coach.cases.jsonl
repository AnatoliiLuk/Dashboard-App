{"id":"acc-current-streak","category":"accuracy","fixture":"steady","locale":"en","messages":[{"role":"user","content":"How long is my current streak for Reading?"}],"checks":[{"type":"streak","habit":"Reading","kind":"current"},{"type":"no_internal_ids"},{"type":"max_tool_calls","max":0}],"note":"The snapshot has the streak, so no tool is needed."}
{"id":"acc-best-streak","category":"accuracy","fixture":"steady","locale":"en","messages":[{"role":"user","content":"What's the best streak I've ever had for Reading?"}],"checks":[{"type":"streak","habit":"Reading","kind":"best"},{"type":"no_internal_ids"}]}
