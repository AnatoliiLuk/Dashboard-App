# Shared by Prisma (root) and the Express API.
# Copy to `.env` at the repo root. Start Postgres with Homebrew or: docker compose up -d

NODE_ENV=development
PORT=4000

DATABASE_URL="postgresql://habit:habit@localhost:5432/habit_tracker?schema=public"

# API integration tests rewrite the database name to habit_tracker_test.
# Set TEST_DATABASE_URL to use a different server.
# End-to-end tests rewrite the database name to habit_tracker_e2e.
# Set E2E_DATABASE_URL to use a different server.

JWT_SECRET=local-dev-jwt-secret-change-me-32chars
JWT_EXPIRES_IN=7d

CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# AI coach. Put the real key only in the gitignored .env.
# The key may be empty when AI_ENABLED=false or NODE_ENV=test.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
AI_MAX_OUTPUT_TOKENS=2048
AI_RATE_LIMIT_PER_MINUTE=10
AI_DAILY_TOKEN_BUDGET=100000
AI_ENABLED=true

# Web app (also set in apps/web/.env.local)
# NEXT_PUBLIC_API_URL=http://localhost:4000/api
