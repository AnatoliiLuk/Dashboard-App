# Shared by Prisma (root) and the Express API.
# Copy to `.env` at the repo root. Start Postgres with Homebrew or: docker compose up -d

NODE_ENV=development
PORT=4000

DATABASE_URL="postgresql://habit:habit@localhost:5432/habit_tracker?schema=public"

# API integration tests rewrite the database name to habit_tracker_test.
# Set TEST_DATABASE_URL to use a different server.
# End-to-end tests rewrite the database name to habit_tracker_e2e.
# Set E2E_DATABASE_URL to use a different server.

JWT_SECRET=local-dev-jwt-secret-change-me-32chars
JWT_EXPIRES_IN=7d

CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# AI coach. See docs/AI_COACH.md. Put the real key only in the gitignored .env.
# The key may be empty when AI_ENABLED=false or NODE_ENV=test.
ANTHROPIC_API_KEY=
# Add a new model to apps/api/src/ai/pricing.ts too.
ANTHROPIC_MODEL=claude-opus-5-5
# Output tokens per model call.
AI_MAX_OUTPUT_TOKENS=2048
# Coach requests per user per minute.
AI_RATE_LIMIT_PER_MINUTE=10
# Tokens per user per UTC day (uncached input + cache writes + output).
AI_DAILY_TOKEN_BUDGET=100000
# Kill switch: false returns 503 from the coach and makes no model calls.
AI_ENABLED=true
# Days a coach conversation is kept after its last message.
AI_CONVERSATION_RETENTION_DAYS=30

# Web app (also set in apps/web/.env.local)
# NEXT_PUBLIC_API_URL=http://localhost:4000/api
