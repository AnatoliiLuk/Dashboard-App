{
  "name": "habit-tracker",
  "private": true,
  "packageManager": "npm@11.11.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@habit-tracker/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "spellcheck": "cspell --no-progress --no-must-find-files --relative '*.*' '**/*.{ts,tsx,js,mjs,md,json,yml}'",
    "lint-staged": "lint-staged",
    "prepare": "husky"
  },
  "devDependencies": {
    "cspell": "^10.3.5",
    "@cspell/dict-uk-ua": "^4.0.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "turbo": "^2.5.0",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,json,md,yml,yaml}": [
      "cspell lint --no-must-find-files --show-suggestions --relative",
      "prettier --write"
    ],
    "*.css": "prettier --write"
  },
  "engines": {
    "node": ">=20"
  }
}
