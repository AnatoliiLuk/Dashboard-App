{
  "name": "habit-tracker",
  "private": true,
  "packageManager": "npm@11.11.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@habit-tracker/web",
    "dev:api": "turbo run dev --filter=@habit-tracker/api",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "spellcheck": "cspell --no-progress --no-must-find-files --relative '*.*' '**/*.{ts,tsx,js,mjs,md,json,yml}'",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.3"
  },
  "devDependencies": {
    "@cspell/dict-uk-ua": "^4.0.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/jest": "^30.0.0",
    "cspell": "^10.3.5",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "prisma": "^6.16.3",
    "ts-jest": "^29.4.14",
    "tsx": "^4.20.5",
    "turbo": "^2.5.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
