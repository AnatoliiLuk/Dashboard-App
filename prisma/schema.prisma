generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  admin
}

enum HabitColor {
  sky
  green
  amber
  rose
  violet
  teal
}

enum GoalColor {
  indigo
  orange
  lime
  magenta
  slate
  crimson
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(user)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  habits      Habit[]
  completions Completion[]
  goals       Goal[]

  @@map("users")
}

model Habit {
  id        String     @id @default(cuid())
  name      String
  color     HabitColor
  userId    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  completions Completion[]
  goalHabits  GoalHabit[]

  @@index([userId])
  @@map("habits")
}

model Completion {
  id          String   @id @default(cuid())
  habitId     String
  userId      String
  completedAt DateTime @db.Date
  createdAt   DateTime @default(now())

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([habitId, completedAt])
  @@index([userId])
  @@index([habitId])
  @@map("completions")
}

model Goal {
  id        String    @id @default(cuid())
  name      String
  color     GoalColor
  startDate DateTime  @db.Date
  endDate   DateTime  @db.Date
  userId    String

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  habits GoalHabit[]

  @@index([userId])
  @@map("goals")
}

model GoalHabit {
  goalId  String
  habitId String

  goal  Goal  @relation(fields: [goalId], references: [id], onDelete: Cascade)
  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@id([goalId, habitId])
  @@index([habitId])
  @@map("goal_habits")
}
