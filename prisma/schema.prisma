generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  admin
}

enum HabitColor {
  sky
  green
  amber
  rose
  violet
  teal
}

enum AiUsageStatus {
  ok
  truncated
  refusal
  error
}

enum CoachRole {
  user
  assistant
}

enum OAuthTokenType {
  access
  refresh
}

enum GoalColor {
  indigo
  orange
  lime
  magenta
  slate
  crimson
}

model User {
  id           String   @id @default(cuid())
  /// Always stored trimmed and lowercased, so the unique index is case-insensitive.
  email        String   @unique
  passwordHash String
  /// Signed into every JWT as `ver`. Incrementing it signs out every session (ADR 0002).
  tokenVersion Int      @default(0)
  name         String
  role         UserRole @default(user)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  habits      Habit[]
  completions Completion[]
  goals       Goal[]
  aiUsage     AiUsage[]
  coachChat   CoachConversation?
  oauthCodes  OAuthAuthorizationCode[]
  oauthTokens OAuthToken[]

  @@map("users")
}

model Habit {
  id         String     @id @default(cuid())
  name       String
  color      HabitColor
  userId     String
  archivedAt DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  completions Completion[]
  goalHabits  GoalHabit[]

  @@index([userId])
  @@map("habits")
}

model Completion {
  id          String   @id @default(cuid())
  habitId     String
  userId      String
  completedAt DateTime @db.Date
  createdAt   DateTime @default(now())

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([habitId, completedAt])
  @@index([userId])
  @@index([habitId])
  @@map("completions")
}

model Goal {
  id         String    @id @default(cuid())
  name       String
  color      GoalColor
  startDate  DateTime  @db.Date
  endDate    DateTime  @db.Date
  userId     String
  archivedAt DateTime?

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  habits GoalHabit[]

  @@index([userId])
  @@map("goals")
}

model GoalHabit {
  goalId  String
  habitId String

  goal  Goal  @relation(fields: [goalId], references: [id], onDelete: Cascade)
  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@id([goalId, habitId])
  @@index([habitId])
  @@map("goal_habits")
}

// One row per AI coach request, including failed ones. Metadata only:
// never the messages. Rows go when the user is deleted.
model AiUsage {
  id               String        @id @default(cuid())
  userId           String
  model            String
  promptVersion    String
  inputTokens      Int           @default(0)
  outputTokens     Int           @default(0)
  cacheReadTokens  Int           @default(0)
  cacheWriteTokens Int           @default(0)
  latencyMs        Int
  toolCalls        Int           @default(0)
  status           AiUsageStatus
  // HTTP status sent to the client when status is error.
  errorStatus      Int?
  createdAt        DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("ai_usage")
}

// The person's one ongoing chat with the coach. It holds what they typed,
// so it expires after AI_CONVERSATION_RETENTION_DAYS without a new message
// and goes when they delete it or their account.
model CoachConversation {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  // Time of the last saved message. Expiry counts from here.
  updatedAt DateTime @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages CoachMessage[]

  @@index([updatedAt])
  @@map("coach_conversations")
}

// Plain text only, as the person saw it. Tool calls are not kept.
model CoachMessage {
  id             String    @id @default(cuid())
  conversationId String
  role           CoachRole
  content        String
  truncated      Boolean   @default(false)
  // The habit proposal shown with an assistant reply, if any.
  proposal       Json?
  createdAt      DateTime  @default(now())

  conversation CoachConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("coach_messages")
}

// MCP clients registered through OAuth dynamic client registration (ADR 0004).
model OAuthClient {
  /// The OAuth client_id.
  id        String   @id
  name      String?
  /// RFC 7591 client information as issued, returned to the OAuth router.
  metadata  Json
  createdAt DateTime @default(now())

  codes  OAuthAuthorizationCode[]
  tokens OAuthToken[]

  @@map("oauth_clients")
}

// Single use, 10 minutes. Only the SHA-256 hash of the code is stored.
model OAuthAuthorizationCode {
  codeHash      String   @id
  clientId      String
  userId        String
  redirectUri   String
  codeChallenge String
  scopes        String[]
  /// The MCP resource URL the code is bound to (RFC 8707).
  resource      String
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("oauth_authorization_codes")
}

// Access and refresh tokens. Only the SHA-256 hash of the token is stored.
model OAuthToken {
  tokenHash    String         @id
  type         OAuthTokenType
  clientId     String
  userId       String
  scopes       String[]
  resource     String
  /// `User.tokenVersion` at issue time; a password change ends the grant (ADR 0002).
  tokenVersion Int
  expiresAt    DateTime
  createdAt    DateTime       @default(now())

  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, clientId])
  @@index([expiresAt])
  @@map("oauth_tokens")
}
