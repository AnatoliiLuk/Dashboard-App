generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  admin
}

enum HabitColor {
  sky
  green
  amber
  rose
  violet
  teal
}

enum AiUsageStatus {
  ok
  truncated
  refusal
  error
}

enum CoachRole {
  user
  assistant
}

enum GoalColor {
  indigo
  orange
  lime
  magenta
  slate
  crimson
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(user)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  habits      Habit[]
  completions Completion[]
  goals       Goal[]
  aiUsage     AiUsage[]
  coachChat   CoachConversation?

  @@map("users")
}

model Habit {
  id         String     @id @default(cuid())
  name       String
  color      HabitColor
  userId     String
  archivedAt DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  completions Completion[]
  goalHabits  GoalHabit[]

  @@index([userId])
  @@map("habits")
}

model Completion {
  id          String   @id @default(cuid())
  habitId     String
  userId      String
  completedAt DateTime @db.Date
  createdAt   DateTime @default(now())

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([habitId, completedAt])
  @@index([userId])
  @@index([habitId])
  @@map("completions")
}

model Goal {
  id         String    @id @default(cuid())
  name       String
  color      GoalColor
  startDate  DateTime  @db.Date
  endDate    DateTime  @db.Date
  userId     String
  archivedAt DateTime?

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  habits GoalHabit[]

  @@index([userId])
  @@map("goals")
}

model GoalHabit {
  goalId  String
  habitId String

  goal  Goal  @relation(fields: [goalId], references: [id], onDelete: Cascade)
  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@id([goalId, habitId])
  @@index([habitId])
  @@map("goal_habits")
}

// One row per AI coach request, including failed ones. Metadata only:
// never the messages. Rows go when the user is deleted.
model AiUsage {
  id               String        @id @default(cuid())
  userId           String
  model            String
  promptVersion    String
  inputTokens      Int           @default(0)
  outputTokens     Int           @default(0)
  cacheReadTokens  Int           @default(0)
  cacheWriteTokens Int           @default(0)
  latencyMs        Int
  toolCalls        Int           @default(0)
  status           AiUsageStatus
  // HTTP status sent to the client when status is error.
  errorStatus      Int?
  createdAt        DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("ai_usage")
}

// The person's one ongoing chat with the coach. It holds what they typed,
// so it expires after AI_CONVERSATION_RETENTION_DAYS without a new message
// and goes when they delete it or their account.
model CoachConversation {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  // Time of the last saved message. Expiry counts from here.
  updatedAt DateTime @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages CoachMessage[]

  @@index([updatedAt])
  @@map("coach_conversations")
}

// Plain text only, as the person saw it. Tool calls are not kept.
model CoachMessage {
  id             String    @id @default(cuid())
  conversationId String
  role           CoachRole
  content        String
  truncated      Boolean   @default(false)
  // The habit proposal shown with an assistant reply, if any.
  proposal       Json?
  createdAt      DateTime  @default(now())

  conversation CoachConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("coach_messages")
}
